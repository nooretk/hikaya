# --- Hikaya backend ----------------------------------------------------------
# Base URL of the Hikaya API. Leave it unset to use the default below.
# If the API is unreachable the app falls back to the bundled sample data and
# shows a "sample data" banner - it never presents mock data as live data.
VITE_API_BASE_URL="http://localhost:3000/api/v1"

# --- Dev server --------------------------------------------------------------
# The frontend listens on 5173 so it does not collide with the backend on 3000.
PORT=5173

# --- Explorer page (Sprint 1 features, optional) ------------------------------
# GEMINI_API_KEY: used by frontend/server.ts for the Gemini narrator, TTS and
# video features on the /explorer page only. The Sprint 2 MVP flow does not
# need it - that goes through the Hikaya backend and the AI module in ai/.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_PLATFORM_KEY: satellite map view on the /explorer page.
GOOGLE_MAPS_PLATFORM_KEY="MY_GOOGLE_MAPS_PLATFORM_KEY"

# APP_URL: where this app is hosted (injected automatically in AI Studio).
APP_URL="MY_APP_URL"
